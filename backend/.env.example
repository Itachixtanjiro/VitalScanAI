# VitalScan AI Backend Configuration

# Application Settings
APP_NAME="VitalScan AI Research Backend"
APP_VERSION="0.1.0-prototype"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Settings (restrict in production!)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Feature Flags
LLM_ENABLED=True
MOCK_ML_PIPELINE=False
LLM_RATE_LIMIT_PER_MIN=10

# TensorFlow Configuration (suppress warnings)
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0

# API Keys (Optional - for LLM services)
# GEMINI_API_KEY=your-key-here
# MEDGEMMA_ENDPOINT=http://localhost:8080
# MISTRAL_API_KEY=your-key-here

# Database
DATABASE_PATH=./data/vitalscan.db
UPLOADS_PATH=./data/uploads

# Logging
LOG_LEVEL=INFO
